# OS / 系统垃圾
.DS_Store
Thumbs.db
desktop.ini

# 编辑器 / IDE
# VS Code 只提交用于保持项目视图整洁的共享设置。
.idea
.vscode/*
!.vscode/settings.json

# Claude Code 本地配置（不应提交，仅本机）
.claude/settings.local.json

# 误入的 Windows UNC 路径文件（拖拽复制产生的垃圾）
*wsl.localhost*

# 误落进项目目录的 shell / 工具配置（本该在 home 里，且多数是空文件）
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc
.gitmodules
.mcp.json

# 依赖 / 构建产物（将来若引入构建工具）
node_modules/
dist/
.cache/
.npm-cache/

# 日志与临时文件
*.log
*~

# Playwright MCP 浏览器工具的输出（截图 / snapshot，本地验证用）
.playwright-mcp/

# Agent 本地运行/验证/审查产物；协议、状态和历史报告仍纳入 Git
.agent/artifacts/
.agent/.cycle.lock/
.agent/.supervisor.lock/
.agent/*.tmp
