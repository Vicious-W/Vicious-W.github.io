# 专用角色的默认执行器、模型、强度与单轮超时。
# 它们只是默认调用配置，不把角色永久绑定到某一种 Agent。
IMPLEMENTER_AGENT=claude
IMPLEMENTER_MODEL=sonnet
IMPLEMENTER_EFFORT=high
IMPLEMENTER_TIMEOUT_SECONDS=7200
REVIEWER_AGENT=codex
REVIEWER_MODEL=gpt-5.6-sol
REVIEWER_EFFORT=high
REVIEWER_TIMEOUT_SECONDS=3600
MONITOR_AGENT=codex
MONITOR_MODEL=gpt-5.6-terra
MONITOR_EFFORT=medium
MONITOR_TIMEOUT_SECONDS=900
MONITOR_MODE=attached

# Claude --print 的无人值守保险。MAX_TURNS 与 API 等价预算任一先到即停止切片；
# supervisor 保存合法现场并对齐下一额度窗口恢复。Codex 调用不读取这些值。
CLAUDE_IMPLEMENTER_MAX_TURNS=36
CLAUDE_IMPLEMENTER_MAX_BUDGET_USD=6.00
CLAUDE_REVIEWER_MAX_TURNS=24
CLAUDE_REVIEWER_MAX_BUDGET_USD=4.00
CLAUDE_MONITOR_MAX_TURNS=8
CLAUDE_MONITOR_MAX_BUDGET_USD=1.00

# Claude 最后一个模型轮次的缓存上下文达到该值后，不再恢复原始 transcript；
# 下一次使用同一任务/角色的结构化交接创建新的压缩代次。
CLAUDE_CONTEXT_ROTATE_TOKENS=160000

# 子进程监管边界（单位：秒）。最大轮数仍由 .agent/state.env 控制。
AGENT_HEARTBEAT_SECONDS=30
AGENT_TERMINATION_GRACE_SECONDS=15

# 跨额度窗口监督策略。恢复时间可在每次 supervise 调用中显式覆盖。
QUOTA_WAIT_SECONDS=18000
MAX_QUOTA_RESUMES=6
SUPERVISOR_HEARTBEAT_SECONDS=300
