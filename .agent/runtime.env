# 双 Agent 子进程运行边界（单位：秒）
# 这些值只控制单轮等待时间，不改变 .agent/state.env 中的最大审查轮数。
CLAUDE_TIMEOUT_SECONDS=7200
CODEX_TIMEOUT_SECONDS=3600
AGENT_HEARTBEAT_SECONDS=30
AGENT_TERMINATION_GRACE_SECONDS=15

# 项目级模型策略。外层脚本显式传参，因此不会再悄悄继承个人全局选择。
# 复杂前端实现采用最新 Sonnet + high，以双 Agent 审查换取质量/额度平衡；
# Opus/xhigh/max 留给三轮后仍无法解决、由所有者人工决定升级的困难任务。
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT=high
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
